# AI Provider Options:
# 1. If using TokenHarbor:
TOKENHARBOR_API_KEY=thk_your_tokenharbor_key_here
# Optional: override base URL or model (default: https://tokenharbor.ai/v1 and deepseek-v4.1-flash:free)
AI_BASE_URL=https://tokenharbor.ai/v1
AI_MODEL=deepseek-v4.1-flash:free

# 2. Or if using direct DeepSeek (default model: deepseek-flash):
# DEEPSEEK_API_KEY=sk-...

# 3. Or if using Google Gemini (free at https://aistudio.google.com/):
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-2.5-flash
# Defaults (tried in order): gemini-2.5-flash, gemini-3.8-flash

# Gmail SMTP Configuration (Nodemailer)
GMAIL_USER=your_dedicated_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
FROM_NAME="Wednesday Worship Program"

# Dev-only escape hatch for local TLS-terminating proxies. Never enable in
# production or on a hosted deployment; it disables SMTP certificate checks.
# SMTP_ALLOW_INSECURE_TLS=true

# Scripture lookup (no key required). bible-api.com serves public-domain
# translations only (KJV, WEB, ASV, BSB, Darby, DRA); other translations fall
# back to the model's text.
# BIBLE_API_BASE_URL=https://bible-api.com

# (No app-level access code.) The endpoint is open by design; protect a public
# deployment at the hosting layer instead, e.g. Vercel Deployment Protection
# (password / SSO) in Project Settings -> Deployment Protection. Do not put
# any secret in the client bundle.
