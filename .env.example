# AI Provider Options:
# 1. If using TokenHarbor:
TOKENHARBOR_API_KEY=thk_your_tokenharbor_key_here
# Optional: override base URL or model (default: https://tokenharbor.ai/v1 and deepseek-v4.1-flash:free)
AI_BASE_URL=https://tokenharbor.ai/v1
AI_MODEL=deepseek-v4.1-flash:free

# 2. Or if using direct DeepSeek:
# DEEPSEEK_API_KEY=sk-...

# 3. Or if using Google Gemini (free at https://aistudio.google.com/):
# GEMINI_API_KEY=AIzaSy...

# Gmail SMTP Configuration (Nodemailer)
GMAIL_USER=your_dedicated_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
FROM_NAME="Wednesday Worship Program"

# Optional passcode that gates /api/generate. When set, the form's hidden
# access code field must match it or the request is rejected with 401.
# Required for any public deployment: without it, anyone with the URL can spend
# your AI credits and send mail from GMAIL_USER.
APP_ACCESS_CODE=
